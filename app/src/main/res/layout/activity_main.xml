<!-- Màn hình khóa sẽ hiển thị đè lên toàn bộ ứng dụng khi hết hạn dùng thử -->
<RelativeLayout
    android:id="@+id/layoutLockScreen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E6000000"
    android:gravity="center"
    android:visibility="gone"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔒 Hết hạn dùng thử"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ứng dụng đã dùng hết 5 ngày miễn phí. Vui lòng mua bản quyền (60.000đ) để tiếp tục sử dụng dịch vụ."
            android:textColor="#CCCCCC"
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/btnBuyPremiumLock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mua Bản Quyền (60.000đ)"
            android:backgroundTint="#FF4500"
            android:textColor="#FFFFFF" />
    </LinearLayout>
</RelativeLayout>
